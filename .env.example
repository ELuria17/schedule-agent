# Copy this to `.env` and fill in your own values.
# Never commit the real .env — see .gitignore.

# ---------- Anthropic (required) ----------
# Get one at console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Populated by running `python setup.py` once. Do not edit by hand.
ENVIRONMENT_ID=
AGENT_ID=

# ---------- Orchestrator auth (required) ----------
# Shared secret the hub + iOS shortcut use. Any long random string.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REPLAN_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_TOKEN

# ---------- iMessage (macOS only) ----------
# Set USER_PHONE to your own number in E.164 format to route the daily
# summary through iMessage. Self-send shows in the Messages badge but
# does NOT push-notify to iPhone (iOS suppresses same-Apple-ID alerts).
# Leave blank to use one of the notifier options below instead.
# USER_PHONE=+15551234567

# ---------- Timezone (optional) ----------
# Defaults to America/New_York. Any IANA zone name works (e.g. Europe/Berlin).
# TIMEZONE=America/New_York

# ---------- Write-calendar name (optional) ----------
# The iCloud calendar the solver writes AUTO-tagged Study Blocks into. You
# must create it yourself in Calendar.app first. Defaults to "Study Blocks".
# WRITE_CALENDAR_NAME=Study Blocks

# ---------- iCloud CalDAV (default calendar) ----------
# Must be your PRIMARY Apple ID email (not a @icloud.com alias if those differ).
# Password is an app-specific password from appleid.apple.com, NOT your real password.
ICLOUD_USER=your-primary-apple-id@example.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---------- Google (Calendar + Gmail scanning + Google Tasks) ----------
# One OAuth client covers all three Google providers — the same
# credentials.json + google_token.json files are shared. The in-app
# setup wizard handles the full Google Cloud Console dance (takes ~10
# minutes once). If you prefer to set this manually, point
# GOOGLE_CALENDAR_CREDENTIALS at the absolute path of your downloaded
# credentials.json. When set, Google Calendar takes priority over
# iCloud / generic CalDAV as the write target.
# GOOGLE_CALENDAR_CREDENTIALS=/Users/you/schedule-agent/credentials.json
# Gmail inbox scanning: Claude reads unread/labeled emails and extracts
# actionable tasks. Costs money (tokens per scan). Off by default.
# ENABLE_GMAIL_SCAN=false
# GMAIL_LABEL_FILTER=                                  # optional, comma-separated Gmail labels
# GMAIL_MAX_MESSAGES=25                                # per-scan cap
# Google Tasks provider: pulls open items from tasks.google.com. Free.
# ENABLE_GOOGLE_TASKS=false

# ---------- Microsoft 365 (Outlook Calendar + Outlook Mail + Microsoft To Do) ----------
# One Azure AD app registration covers all three Microsoft providers.
# The in-app setup wizard walks through the Azure portal steps.
# Required to enable any Microsoft provider:
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT=common                              # "common" for personal Microsoft accounts, or your tenant GUID for work/school
# When MICROSOFT_CLIENT_ID is set, Outlook Calendar takes priority as the
# write calendar (above iCloud, below Google).
# ENABLE_OUTLOOK_CALENDAR=false                        # write Study Blocks into Outlook
# ENABLE_OUTLOOK_MAIL_SCAN=false                       # Claude-scan unread Outlook mail for tasks
# OUTLOOK_MAIL_FOLDER=inbox                            # folder to scan
# OUTLOOK_CATEGORY_FILTER=                             # optional, comma-separated Outlook categories
# OUTLOOK_MAX_MESSAGES=25
# ENABLE_MICROSOFT_TODO=false                          # pull tasks from Microsoft To Do

# ---------- Generic CalDAV server (Fastmail / Posteo / Nextcloud / self-hosted) ----------
# Leave ALL of these unset to use iCloud (above). Set all three to use another server.
# Known endpoints:
#   Fastmail    https://caldav.fastmail.com/
#   Posteo      https://posteo.de:8443/
#   Mailbox.org https://dav.mailbox.org/
#   Nextcloud   https://your-nextcloud/remote.php/dav/
# CALDAV_URL=https://caldav.fastmail.com/
# CALDAV_USER=you@fastmail.com
# CALDAV_PASSWORD=your-service-password

# ---------- Canvas LMS (required if a CanvasTaskSource is configured) ----------
# Personal access token from <your-canvas>/profile/settings. The base URL for
# your school can be overridden with CANVAS_BASE_URL; default is psu.instructure.com.
CANVAS_TOKEN=REPLACE_ME
# CANVAS_BASE_URL=https://your-school.instructure.com/api/v1

# ---------- Todoist (required only if you want AutoPlan to pull from Todoist) ----------
# Personal access token from Settings → Integrations → Developer in the
# Todoist web app. If set, schedule_config.py automatically enables the
# TodoistTaskSource. If unset, it's skipped silently.
# TODOIST_TOKEN=REPLACE_ME

# ---------- Notifier — pick exactly one ----------
# schedule_config.py picks the first notifier whose env vars are set, in
# the order iMessage → Pushover → Slack → Email → ntfy. Leave the others
# blank or commented to skip them. Typical setup: pick your favorite and
# fill in only that block.

# -- ntfy.sh (cross-platform, free, no account needed) --
# Any hard-to-guess string — treat as a secret. Anyone who knows the topic
# can both publish to and read your notifications. Install the ntfy app
# on your phone/desktop and subscribe to the same topic.
# NTFY_TOPIC=autoplan-REPLACE_WITH_LONG_RANDOM_STRING

# -- Pushover ($5 one-time per platform, most reliable push) --
# Sign up at pushover.net, find USER_KEY on the dashboard. Then go to
# pushover.net/apps/build, create an app named "AutoPlan", copy the token.
# PUSHOVER_USER_KEY=your-user-key
# PUSHOVER_APP_TOKEN=your-application-token
# PUSHOVER_DEVICE=              # optional: restrict to one device name

# -- Slack (free, via Incoming Webhook) --
# api.slack.com/apps → Create New App → From scratch → Incoming Webhooks
# → Add New Webhook to Workspace → pick a channel or DM → copy URL.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxx
# SLACK_USERNAME=AutoPlan
# SLACK_ICON_EMOJI=:calendar:

# -- Email (SMTP; works with Gmail, Outlook, Fastmail, SES, Mailgun, ...) --
# Gmail: create an app password at myaccount.google.com/apppasswords.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com        # defaults to SMTP_USERNAME if unset
# SMTP_TO=you@gmail.com          # defaults to SMTP_USERNAME; set to deliver to another address
# SMTP_USE_TLS=1                 # 1 = STARTTLS on port 587 (default); 0 = no
# SMTP_USE_SSL=0                 # 1 = direct TLS on port 465; mutually exclusive with USE_TLS
